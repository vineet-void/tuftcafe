/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/assets/reviews/*.mp4
  Content-Type: video/mp4
  Cache-Control: public, max-age=31536000

/assets/*.mp4
  Content-Type: video/mp4
  Cache-Control: public, max-age=31536000

/assets/*.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=31536000

/assets/reviews/*.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=31536000

/*.html
  Cache-Control: no-cache, must-revalidate
